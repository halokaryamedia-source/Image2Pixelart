{
	"name": "mivubi-mosaic-realtime",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-29",
	"compatibility_flags": ["nodejs_compat"],
	"durable_objects": {
		"bindings": [
			{ "name": "PROJECT_ROOMS", "class_name": "ProjectRoom" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["ProjectRoom"] }
	],
	"vars": {
		"ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,https://mivubi-pixel-mosaic.vercel.app"
	}
}
