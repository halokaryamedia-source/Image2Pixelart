# MIVUBI Mosaic Plan — safe configuration template.
# Copy this file to .env.local for local development.
# Never commit real credentials or production secrets.

# Neon PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Cloudflare R2 runtime credentials
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_REGION=auto
R2_BUCKET_NAME=replace-with-r2-bucket-name

# Realtime service shared configuration.
# REALTIME_TOKEN_SECRET and REALTIME_INTERNAL_SECRET must match
# realtime/.dev.vars for local Worker development and should be >= 32 characters.
REALTIME_HTTP_URL=http://127.0.0.1:8787
REALTIME_TOKEN_SECRET=replace-with-at-least-32-character-token-secret
REALTIME_INTERNAL_SECRET=replace-with-at-least-32-character-internal-secret

# Vercel maintenance cron
CRON_SECRET=replace-with-maintenance-cron-secret

# Optional cloud smoke target
SMOKE_BASE_URL=http://127.0.0.1:5173

# Deployment-only values for scripts/configure-r2-cors.mjs.
# These are not required for ordinary application development.
CLOUDFLARE_API_TOKEN=replace-with-cloudflare-api-token
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
